# Server / deployment values. Never commit a populated .env.
AWS_REGION=ap-south-1
# Intended local SSO profile; no credentials/keys belong in this file.
AWS_PROFILE=jalnet
EVENTS_TABLE=
REPORTS_TABLE=
USERS_TABLE=
DROPLET_LEDGER_TABLE=
EVIDENCE_BUCKET=
MEDIA_QUEUE_URL=
BEDROCK_MODEL_ID=
AMAZON_LOCATION_REGION=ap-south-1
MAX_IMAGE_BYTES=4000000
DEMO_MODE=false

# Public mobile configuration. Only the restricted expiring maps-only key may
# appear here; never add AWS secret keys, JWTs or a Cognito client secret.
EXPO_PUBLIC_PROVIDER_MODE=local-demo
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8787
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_BUILD_ENV=dev
EXPO_PUBLIC_LOCATION_MAP_KEY=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=

# Stretch features stay off until their acceptance criteria pass.
VIDEO_REPORTS_ENABLED=false
WATER_STRESS_ENABLED=false
MY_WATER_ENABLED=false
TANKER_OS_ENABLED=false
PUBLIC_ALERTS_ENABLED=false
ROUTE_ALTERNATIVES_ENABLED=false
BACKGROUND_ROUTE_LEARNING_ENABLED=false
